# This is a template for creating secrets
# DO NOT commit actual secrets to source control
# Use Azure Key Vault with CSI driver or external secrets operator in production

apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: applications
type: Opaque
stringData:
  db-connection-string: "Server=tcp:${SQL_SERVER_FQDN},1433;Initial Catalog=${SQL_DATABASE_NAME};Persist Security Info=False;User ID=${SQL_ADMIN_USERNAME};Password=${SQL_ADMIN_PASSWORD};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  storage-connection-string: "DefaultEndpointsProtocol=https;AccountName=${STORAGE_ACCOUNT_NAME};AccountKey=${STORAGE_ACCOUNT_KEY};EndpointSuffix=core.windows.net"
