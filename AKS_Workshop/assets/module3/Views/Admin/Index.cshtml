@model System.Collections.Generic.List<Product>
@{ ViewData["Title"] = "Manage products"; }
<section class="section"><div class="section-heading"><div><span class="eyebrow">BAKERY ADMIN</span><h1>Manage products</h1></div><a class="button" asp-action="Create"><i data-lucide="plus" aria-hidden="true"></i> Add product</a></div><p class="notice warning">Demo admin: no authentication. Everyone with access to this app can add, edit and delete products.</p><div class="table-scroll"><table><caption class="sr-only">Bakery products</caption><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Actions</th></tr></thead><tbody>@foreach (var product in Model) { <tr><td><div class="table-product"><img src="@product.Image" alt="" /><div><strong>@product.Name</strong><small>ID @product.ID</small></div></div></td><td>@product.Category</td><td>@product.Price.ToString("C")</td><td><div class="actions"><a class="icon-button" asp-controller="Products" asp-action="Details" asp-route-id="@product.ID" title="View @product.Name" aria-label="View @product.Name"><i data-lucide="eye" aria-hidden="true"></i></a><a class="icon-button" asp-action="Edit" asp-route-id="@product.ID" title="Edit @product.Name" aria-label="Edit @product.Name"><i data-lucide="pencil" aria-hidden="true"></i></a><a class="icon-button danger" asp-action="Delete" asp-route-id="@product.ID" title="Delete @product.Name" aria-label="Delete @product.Name"><i data-lucide="trash-2" aria-hidden="true"></i></a></div></td></tr> }</tbody></table></div>@if (Model.Count == 0) { <p>No products yet. Add your first bake.</p> }</section>