@model Product
@{ ViewData["Title"] = Model.Name; }
<section class="section"><a class="text-link" asp-action="Index"><i data-lucide="arrow-left" aria-hidden="true"></i> All bakes</a><div class="product-detail"><img src="@Model.Image" alt="@Model.Name" /><div><span class="eyebrow">@Model.Category</span><h1>@Model.Name</h1><p class="price">@Model.Price.ToString("C")</p><p>@Model.Description</p><form class="add-form" asp-controller="Cart" asp-action="Add" asp-route-id="@Model.ID" method="post"><div><label for="quantity">Quantity</label><input id="quantity" name="quantity" type="number" min="1" max="99" value="1" required /></div><button class="button" type="submit"><i data-lucide="shopping-bag" aria-hidden="true"></i> Add to basket</button></form><p class="muted">Local pickup. Demo orders only.</p><details><summary>Ingredients &amp; allergens</summary><p>May contain wheat, milk, eggs, soy, peanuts and tree nuts. Prepared in a shared kitchen. This demo does not provide verified allergen information.</p></details></div></div></section>