@model CheckoutViewModel
@{ ViewData["Title"] = "Checkout"; }
<section class="page-heading"><span class="eyebrow">ONE LAST LITTLE THING</span><h1>Make it yours.</h1><p>Pickup details for your demo order.</p></section>
<section class="section checkout-layout"><form asp-action="Checkout" method="post"><h2>Your details</h2><p class="notice warning">Workshop demo only. Use fictional contact information. No payment is collected and nothing will be prepared.</p><div asp-validation-summary="All" class="validation-summary" role="alert"></div><div class="field"><label asp-for="CustomerName"></label><input asp-for="CustomerName" autocomplete="name" maxlength="100" required /><span asp-validation-for="CustomerName"></span></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="email" maxlength="200" required /><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Notes"></label><textarea asp-for="Notes" rows="3" maxlength="500"></textarea><span asp-validation-for="Notes"></span></div><p>Pickup: sample Pike Street location. No email confirmation is sent.</p><button class="button" type="submit"><i data-lucide="check" aria-hidden="true"></i> Place demo order</button></form><aside class="order-totals"><h2>Order summary</h2>@foreach (var line in Model.Cart.Lines) { <div class="total-row"><span>@line.Quantity x @line.Product.Name</span><span>@line.Total.ToString("C")</span></div> }<div class="total-row"><span>Pickup</span><span>Free</span></div><div class="total-row grand-total"><span>Total (USD)</span><strong>@Model.Cart.Total.ToString("C")</strong></div><a class="text-link" asp-controller="Cart" asp-action="Index">Edit basket</a></aside></section>