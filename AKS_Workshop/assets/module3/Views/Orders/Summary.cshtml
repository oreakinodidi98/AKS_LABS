@model Order
@{ ViewData["Title"] = "Order summary"; }
<section class="page-heading"><span class="eyebrow">THANK YOU, @Model.CustomerName</span><h1>A little joy, on its way.</h1><p>Your demo order has been saved.</p></section>
<section class="section prose"><h2>Order #@Model.ID.ToString("D6")</h2><p class="muted">@Model.CreatedUtc.ToString("MMMM d, yyyy HH:mm") UTC</p><div class="table-scroll"><table><caption class="sr-only">Your order items</caption><thead><tr><th>Product</th><th>Qty</th><th>Total</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.ProductName</td><td>@item.Quantity</td><td>@((item.UnitPrice * item.Quantity).ToString("C"))</td></tr> }</tbody></table></div><div class="total-row grand-total"><span>Total (USD)</span><strong>@Model.Items.Sum(item => item.UnitPrice * item.Quantity).ToString("C")</strong></div><h3>Pickup details</h3><p>@Model.CustomerName<br />@Model.Email</p>@if (!string.IsNullOrWhiteSpace(Model.Notes)) { <p><strong>Notes:</strong> @Model.Notes</p> }<p class="notice warning">This is a demo receipt, not a real order. No payment was taken, no email was sent, and no pickup will be prepared.</p><a class="button" asp-controller="Products" asp-action="Index">Back to our bakes <i data-lucide="arrow-right" aria-hidden="true"></i></a></section>